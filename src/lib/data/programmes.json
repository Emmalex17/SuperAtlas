    "id": "p1",
    "name": "ISR 2026 annual assessment",
    "reg": "isr",
    "status": "Open",
    "opens": "2026-10-01",
    "closes": "2026-11-30",
    "created": "12 Sep 2026",
    "types": [
      "Commercial bank",
      "Microfinance bank"
    ],
    "desc": "Yearly information security assessment for banks, assessed by accredited firms.",
    "locked": "1 Oct 2026",
    "qset": {
      "ver": "v2.0",
      "sections": [
        {
          "id": "s1",
          "name": "1. Governance",
          "on": true,
          "reqs": [
            {
              "ref": "ISR-1.1",
              "t": "Board-approved information security policy",
              "text": "The organisation shall maintain an information security policy approved by its board and reviewed at least once a year.",
              "guidance": "Upload the policy and the board resolution that approved the current version. If the review is overdue, say when it is scheduled.",
              "weight": "High (3)",
              "evidence": [
                "Board resolution approving the policy",
                "Current policy document"
              ],
              "questions": [
                {
                  "id": "ISR-1.1#0",
                  "text": "Does the board approve the information security policy?",
                  "hint": "Yes / No / Not applicable"
                },
                {
                  "id": "ISR-1.1#1",
                  "text": "When did the board last review the policy?",
                  "hint": "Date"
                },
                {
                  "id": "ISR-1.1#2",
                  "text": "Who owns the policy day to day?",
                  "hint": "Short text"
                }
              ]
            },
            {
              "ref": "ISR-1.2",
              "t": "Named chief information security officer",
              "text": "The organisation shall appoint a chief information security officer who reports to executive management.",
              "guidance": "Give the name and reporting line. If the role is outsourced, describe the arrangement.",
              "weight": "Normal (2)",
              "evidence": [
                "Appointment letter",
                "Organisation chart"
              ],
              "questions": [
                {
                  "id": "ISR-1.2#0",
                  "text": "Has a chief information security officer been appointed?",
                  "hint": "Yes / No / Not applicable"
                },
                {
                  "id": "ISR-1.2#1",
                  "text": "To whom does the CISO report?",
                  "hint": "Short text"
                }
              ]
            },
            {
              "ref": "ISR-1.3",
              "t": "Annual information security risk assessment",
              "text": "The organisation shall carry out an information security risk assessment at least once a year and after any major change.",
              "guidance": "Summarise the method used and the top risks identified.",
              "weight": "Normal (2)",
              "evidence": [
                "Latest risk assessment report",
                "Risk register extract"
              ],
              "questions": [
                {
                  "id": "ISR-1.3#0",
                  "text": "Was a risk assessment completed in the last 12 months?",
                  "hint": "Yes / No / Not applicable"
                },
                {
                  "id": "ISR-1.3#1",
                  "text": "Describe the method used",
                  "hint": "Long text"
                }
              ]
            }
          ]
        },
        {
          "id": "s2",
          "name": "2. Asset management",
          "on": true,
          "reqs": [
            {
              "ref": "ISR-2.1",
              "t": "Inventory of critical information assets",
              "text": "Keep an up-to-date inventory of critical information assets, with a named owner for each.",
              "guidance": "Upload the inventory or an extract showing critical assets and owners.",
              "weight": "Normal (2)",
              "evidence": [
                "Asset inventory extract"
              ],
              "questions": [
                {
                  "id": "ISR-2.1#0",
                  "text": "Is there a current inventory of critical assets?",
                  "hint": "Yes / No / Not applicable"
                },
                {
                  "id": "ISR-2.1#1",
                  "text": "How many critical assets are listed?",
                  "hint": "Number"
                }
              ]
            }
          ]
        },
        {
          "id": "s4",
          "name": "4. Access control",
          "on": true,
          "reqs": [
            {
              "ref": "ISR-4.1",
              "t": "Multi-factor authentication for privileged access",
              "text": "All privileged and remote access to production systems shall require multi-factor authentication.",
              "guidance": "Explain how MFA is enforced for administrators and remote users. Include any exceptions and how they are approved.",
              "weight": "High (3)",
              "evidence": [
                "MFA configuration export",
                "List of privileged accounts"
              ],
              "questions": [
                {
                  "id": "ISR-4.1#0",
                  "text": "Is MFA enforced for all privileged access?",
                  "hint": "Yes / No / Not applicable"
                },
                {
                  "id": "ISR-4.1#1",
                  "text": "Is MFA enforced for all remote access?",
                  "hint": "Yes / No / Not applicable"
                },
                {
                  "id": "ISR-4.1#2",
                  "text": "List any approved exceptions",
                  "hint": "Long text"
                }
              ]
            },
            {
              "ref": "ISR-4.2",
              "t": "Quarterly access review",
              "text": "Access rights to critical systems shall be reviewed at least quarterly and unused accounts removed within 30 days.",
              "guidance": "Attach the last two signed access reviews.",
              "weight": "Normal (2)",
              "evidence": [
                "Signed access review reports for the last two quarters"
              ],
              "questions": [
                {
                  "id": "ISR-4.2#0",
                  "text": "Are access rights reviewed every quarter?",
                  "hint": "Yes / No / Not applicable"
                },
                {
                  "id": "ISR-4.2#1",
                  "text": "Date of the last review",
                  "hint": "Date"
                }
              ]
            }
          ]
        },
        {
          "id": "s7",
          "name": "7. Incident response",
          "on": true,
          "reqs": [
            {
              "ref": "ISR-7.1",
              "t": "Report major incidents within 24 hours",
              "text": "Major security incidents shall be reported to the regulator within 24 hours of detection.",
              "guidance": "Describe how incidents are classified and who reports them.",
              "weight": "High (3)",
              "evidence": [
                "Incident response plan",
                "Incident log for the period"
              ],
              "questions": [
                {
                  "id": "ISR-7.1#0",
                  "text": "Is there a documented incident response plan?",
                  "hint": "Yes / No / Not applicable"
                },
                {
                  "id": "ISR-7.1#1",
                  "text": "How many major incidents were reported in the period?",
                  "hint": "Number"
                }
              ]
            },
            {
              "ref": "ISR-7.2",
              "t": "Test the incident response plan yearly",
              "text": "The incident response plan shall be tested at least once a year through a tabletop or live exercise.",
              "guidance": "Attach the exercise report and the actions that came out of it.",
              "weight": "Normal (2)",
              "evidence": [
                "Exercise report"
              ],
              "questions": [
                {
                  "id": "ISR-7.2#0",
                  "text": "Was the plan tested in the last 12 months?",
                  "hint": "Yes / No / Not applicable"
                }
              ]
            }
          ]
        }
      ]
    },
    "ver": "v2.0",
    "edited": 2,
    "series": "isr",
    "cycle": "2026"
  },
