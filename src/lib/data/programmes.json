              "evidence": [
                "Lawful basis register"
              ],
              "questions": [
                {
                  "id": "DPF-2.2#0",
                  "text": "Is a lawful basis recorded for every purpose?",
                  "hint": "Yes / No / Not applicable"
                }
              ]
            }
          ]
        },
        {
          "id": "s5",
          "name": "5. Breach handling",
          "on": true,
          "reqs": [
            {
              "ref": "DPF-5.1",
              "t": "Notify personal data breaches within 72 hours",
              "text": "Notify the authority of personal data breaches within 72 hours of becoming aware of them.",
              "guidance": "",
              "weight": "High (3)",
              "evidence": [
                "Breach procedure",
                "Breach log"
              ],
              "questions": [
                {
                  "id": "DPF-5.1#0",
                  "text": "Is there a breach notification procedure?",
                  "hint": "Yes / No / Not applicable"
                }
              ]
            }
          ]
        }
      ]
    },
